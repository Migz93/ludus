+static bool isLudusMember(const QString &name, gid_t primaryGroup)
+{
+    const group *ludusGroup = getgrnam("ludus");
+    if (!ludusGroup) {
+        return false;
+    }
+    if (primaryGroup == ludusGroup->gr_gid) {
+        return true;
+    }
+    for (char **member = ludusGroup->gr_mem; member && *member; ++member) {
+        if (name == QString::fromLocal8Bit(*member)) {
+            return true;
+        }
+    }
+    return false;
+}
