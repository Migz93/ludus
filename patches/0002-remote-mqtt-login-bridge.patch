+// A deliberately tiny, read-only bridge for Ludus' root-owned MQTT service.
+// The service writes a validated username into this runtime file only while
+// the greeter is displayed. QML still verifies that the user is in its
+// filtered UserModel before it asks Plasma Login to authenticate the session.
+class RemoteLogin : public QObject
+{
+    Q_OBJECT
+public:
+    Q_INVOKABLE QString takeRequestedUser() const
+    {
+        QFile file(QStringLiteral("/run/ludus/mqtt-login.json"));
+        if (!file.open(QIODevice::ReadOnly)) return {};
+        const auto document = QJsonDocument::fromJson(file.readAll());
+        if (!document.isObject()) return {};
+        return document.object().value(QStringLiteral("user")).toString();
+    }
+};
