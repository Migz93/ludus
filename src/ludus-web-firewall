#!/usr/bin/env bash
# Expose only the Ludus WebUI port. Never assign sources to a zone.
set -Eeuo pipefail
port=9304
state=/etc/ludus/webui-firewall-zone
ownership=/etc/ludus/webui-firewall-port-owned
if ! firewall-cmd --state >/dev/null 2>&1; then
    echo "ludus-web-firewall: firewalld is not active; no port was opened" >&2
    exit 0
fi
zone=$(cat "$state" 2>/dev/null || firewall-cmd --get-default-zone)
# A plain port opening is safe only in a zone explicitly intended for a
# private network.  The WebUI independently checks source addresses, but do
# not rely on that application-level check to compensate for a public zone.
case "$zone" in
    # FedoraWorkstation is Bazzite's default workstation zone. The WebUI's
    # independent private-subnet check remains mandatory for that zone.
    home|internal|trusted|FedoraWorkstation) ;;
    *)
        echo "ludus-web-firewall: refusing to open TCP $port in untrusted zone '$zone'; use a home, internal, trusted, or FedoraWorkstation firewalld zone" >&2
        exit 1
        ;;
esac
if ! firewall-cmd --permanent --zone="$zone" --query-port="$port/tcp" >/dev/null; then
    firewall-cmd --permanent --zone="$zone" --add-port="$port/tcp" >/dev/null
    # Uninstall may remove only a rule Ludus knows it added.  Do not claim an
    # administrator's pre-existing rule merely because it uses this port.
    install -d -m 0755 /etc/ludus
    : > "$ownership"
fi
install -d -m 0755 /etc/ludus
printf '%s\n' "$zone" > "$state"
firewall-cmd --reload
echo "ludus-web-firewall: opened only TCP $port in zone $zone"
