#!/usr/bin/env bash
# Ludus shared-library administration.  SPDX-License-Identifier: GPL-3.0-or-later
set -Eeuo pipefail

config_dir=/etc/ludus
libraries_file="$config_dir/libraries.conf"
group=ludus
disks=/usr/local/lib/ludus/ludus-disks

die() { echo "ludusctl: $*" >&2; exit 1; }
note() { echo "ludusctl: $*"; }
require_root() { (( EUID == 0 )) || die "this operation must be run as root"; }

usage() {
    cat <<'EOF'
Usage: ludusctl <command>

  status | doctor
  users list | users enroll <user> | users remove <user>
  libraries list | libraries candidates | libraries add <absolute-path>
  libraries add-default <mounted-path> | libraries remove <path>
  libraries migrate <configured-path> [--yes]
  libraries check | libraries repair
  repair
  disks list | disks mount <unmounted-partition>
EOF
}

ensure_config() {
    install -d -m 0755 "$config_dir"
    [[ -e "$libraries_file" ]] || install -m 0644 /dev/null "$libraries_file"
}

canonical_path() {
    local path=$1
    [[ "$path" == /* ]] || die "library paths must be absolute"
    [[ "$path" != *$'\n'* && "$path" != *$'\r'* ]] || die "library paths cannot contain line breaks"
    [[ -d "$path" ]] || die "library path does not exist: $path"
    realpath -e -- "$path"
}

library_paths() {
    [[ -f "$libraries_file" ]] || return 0
    while IFS= read -r path || [[ -n "$path" ]]; do
        [[ -z "$path" || "$path" == \#* ]] && continue
        printf '%s\n' "$path"
    done < "$libraries_file"
}

library_id() { printf '%s' "$1" | sha256sum | cut -c1-16; }

# A normal WebUI choice is a mounted local filesystem.  Keep the generated
# game directory predictable, but do not create it until the administrator
# explicitly chooses that filesystem.
library_candidates() {
    local target source fstype options default seen='|'
    while read -r target source fstype options; do
        [[ "$source" == /dev/* && ( "$options" == rw,* || "$options" == *,rw,* ) ]] || continue
        # Bazzite exposes several btrfs subvolumes. /var is the one persistent
        # OS-managed choice; presenting /etc, /boot, or a Ludus bind mount as a
        # "disk" would be both confusing and unsafe.
        [[ "$target" == /boot || "$target" == /etc || "$target" == /sysroot* || "$target" == */steamapps/compatdata || "$target" == */steamapps/shadercache ]] && continue
        [[ "$source" != *'['* || "$target" == /var ]] || continue
        if [[ "$target" == /var ]]; then default=/srv/steam-library; else default="$target/steam-library"; fi
        [[ "$seen" == *"|$target|"* ]] && continue; seen+="$target|"
        printf '%s\t%s\t%s\t%s\n' "$target" "$source" "$fstype" "$default"
    done < <(findmnt -rn -t btrfs,ext4,xfs -o TARGET,SOURCE,FSTYPE,OPTIONS)
}

add_default_library() {
    local mount=$1 target source fstype default
    while IFS=$'\t' read -r target source fstype default; do
        [[ "$target" == "$mount" ]] || continue
        install -d -o root -g "$group" -m 2775 "$default"
        cmd_libraries add "$default"
        return
    done < <(library_candidates)
    die "not a supported writable local filesystem mount: $mount"
}

user_home() { getent passwd "$1" | awk -F: '{print $6}'; }
user_uid() { getent passwd "$1" | awk -F: '{print $3}'; }
user_primary_group() { id -gn "$1"; }

steam_initialized_for() {
    local user=$1 home
    home=$(user_home "$user")
    # loginusers.vdf is written only after Steam has accepted an account login.
    # This is the safe point at which Ludus may edit that user's VDF files.
    runuser -u "$user" -- test -s "$home/.local/share/Steam/config/loginusers.vdf"
}

valid_user() {
    local user=$1 uid home shell uid_min
    IFS=: read -r _ _ uid _ _ home shell < <(getent passwd "$user") || return 1
    uid_min=$(awk '/^UID_MIN[[:space:]]/{print $2; exit}' /etc/login.defs 2>/dev/null || true)
    uid_min=${uid_min:-1000}
    # Fedora Atomic/Bazzite commonly places homes under /var/home; conventional
    # Fedora installations use /home.  Both are real interactive-user homes.
    [[ "$uid" =~ ^[0-9]+$ && "$uid" -ge "$uid_min" && ( "$home" == /home/* || "$home" == /var/home/* ) && -d "$home" ]]
}

steam_running_for() {
    local user=$1 uid
    uid=$(user_uid "$user")
    pgrep -u "$uid" -f '(^|/)(steam|steamwebhelper|bazzite-steam)( |$)' >/dev/null 2>&1
}

assert_steam_stopped() {
    local user running=()
    while IFS= read -r user; do
        steam_running_for "$user" && running+=("$user")
    done < <(enrolled_users)
    ((${#running[@]} == 0)) || die "Steam is running for: ${running[*]}. Ask them to sign out before changing libraries."
}

enrolled_users() {
    getent group "$group" | awk -F: '{gsub(/,/, "\n", $4); print $4}' | sed '/^$/d'
}

ensure_group() { getent group "$group" >/dev/null || groupadd --system "$group"; }

private_dir() {
    local user=$1 library=$2 name=$3 home id
    home=$(user_home "$user"); id=$(library_id "$library")
    printf '%s/.local/share/ludus/steam-libraries/%s/%s\n' "$home" "$id" "$name"
}

prepare_user_private_dirs() {
    local user=$1 library=$2 name dir
    for name in compatdata shadercache; do
        dir=$(private_dir "$user" "$library" "$name")
        install -d -o "$user" -g "$(user_primary_group "$user")" -m 0700 "$dir"
    done
}

# The private bind targets must be empty because changing a populated target
# would silently hide data.  A migration workflow will handle that explicitly.
prepare_library() {
    local library=$1 apps target name user
    # Group permissions on the library itself are insufficient if one of its
    # ancestors is private (for example /var/lib/ludus). Every enrolled player
    # must be able to traverse the path before Steam can use it.
    while IFS= read -r user; do
        runuser -u "$user" -- test -x "$library" || die "$user cannot traverse $library; choose a path accessible to all Ludus users"
    done < <(enrolled_users)
    apps="$library/steamapps"
    install -d -o root -g "$group" -m 2775 "$library" "$apps" \
        "$apps/common" "$apps/workshop"
    for name in compatdata shadercache; do
        target="$apps/$name"
        if [[ -e "$target" && ! -d "$target" ]]; then
            die "$target exists but is not a directory"
        fi
        if [[ -d "$target" ]] && find "$target" -mindepth 1 -maxdepth 1 -print -quit | grep -q .; then
            die "$target contains existing data; migration is required before Ludus can make it private"
        fi
        install -d -o root -g root -m 000 "$target"
        # A setgid parent can cause new directories to inherit its setgid bit
        # even when install is given mode 000.  Locked bind targets must have
        # no permissions or special bits while unmounted.
        chmod g-s "$target"
        chmod 000 "$target"
    done
}

check_library() {
    local library=$1 apps expected actual errors=0 name target
    apps="$library/steamapps"
    [[ -d "$library" ]] || { echo "ERROR library missing: $library"; return 1; }
    actual=$(stat -c '%U:%G %a' "$library")
    [[ "$actual" == "root:$group 2775" ]] || { echo "WARNING $library permissions are $actual; expected root:$group 2775"; ((errors+=1)); }
    for name in common workshop; do
        [[ -d "$apps/$name" ]] || { echo "ERROR missing $apps/$name"; ((errors+=1)); }
    done
    for name in compatdata shadercache; do
        target="$apps/$name"
        [[ -d "$target" ]] || { echo "ERROR missing private bind target $target"; ((errors+=1)); continue; }
        if [[ "$(findmnt -rn -o TARGET -T "$target" 2>/dev/null | head -n1)" == "$target" ]]; then
            echo "WARNING $target has an active bind mount"
        else
            actual=$(stat -c '%U:%G %a' "$target")
            [[ "$actual" == "root:root 0" ]] || { echo "ERROR $target permissions are $actual; expected root:root 0"; ((errors+=1)); }
        fi
    done
    return "$errors"
}

repair_library() {
    local library=$1 apps path
    prepare_library "$library"
    apps="$library/steamapps"
    # Do not traverse other mounted filesystems or touch the private bind targets.
    while IFS= read -r -d '' path; do chgrp "$group" "$path"; chmod g+rwX "$path"; done \
        < <(find "$library" -xdev \( -path "$apps/compatdata" -o -path "$apps/shadercache" \) -prune -o -print0)
    find "$library" -xdev -type d \( -path "$apps/compatdata" -o -path "$apps/shadercache" \) -prune -o -exec chmod g+s {} +
}

manifest_install_dir() {
    sed -n 's/.*"installdir"[[:space:]]*"\([^"]*\)".*/\1/p' "$1" | head -n1
}

confirm_migration() {
    local library=$1 answer
    echo "Migration will move eligible installed game files into $library."
    echo "Steam is stopped, but source game copies and matching manifests will be removed only after rsync checksum verification."
    [[ "${2:-}" == --yes ]] && return 0
    [[ -t 0 ]] || die "migration needs --yes when run non-interactively"
    read -r -p 'Continue? [y/N] ' answer
    [[ "$answer" =~ ^[Yy]$ ]] || die "migration cancelled"
}

# Move only unambiguous, complete game directories. Existing destination data or
# conflicting manifests are reported and left untouched for a future explicit
# resolution workflow. rsync's checksum dry run completes before source removal.
migrate_library() {
    local library=$1 confirmation=${2:-} apps user home source game name dest manifest target_manifest
    local migrated=0 skipped=0
    require_root; command -v rsync >/dev/null || die "rsync is required for migration"
    assert_steam_stopped; prepare_library "$library"; confirm_migration "$library" "$confirmation"
    apps="$library/steamapps"
    while IFS= read -r user; do
        home=$(user_home "$user")
        source="$home/.local/share/Steam/steamapps"
        [[ -d "$source/common" ]] || continue
        while IFS= read -r -d '' game; do
            name=$(basename "$game"); dest="$apps/common/$name"
            if [[ -e "$dest" ]]; then
                note "migration skipped $user/$name: destination already exists"
                ((skipped+=1)); continue
            fi
            note "migrating $user/$name"
            rsync -aHAX -- "$game/" "$dest/"
            if rsync -aHAXnc --delete --dry-run -- "$game/" "$dest/" | grep -q .; then
                note "migration retained source $user/$name: checksum verification did not match"
                ((skipped+=1)); continue
            fi
            chgrp -R "$group" "$dest"; chmod -R g+rwX "$dest"; find "$dest" -type d -exec chmod g+s {} +
            # A manifest is moved only when it unambiguously names this game.
            manifest=$(find "$source" -maxdepth 1 -type f -name 'appmanifest_*.acf' -print0 | while IFS= read -r -d '' candidate; do
                [[ "$(manifest_install_dir "$candidate")" == "$name" ]] && { printf '%s' "$candidate"; break; }
            done)
            if [[ -n "$manifest" ]]; then
                target_manifest="$apps/$(basename "$manifest")"
                if [[ -e "$target_manifest" ]] && ! cmp -s "$manifest" "$target_manifest"; then
                    note "migration retained source $user/$name: manifest conflicts with $(basename "$target_manifest")"
                    rm -rf -- "$dest"
                    ((skipped+=1)); continue
                fi
                [[ -e "$target_manifest" ]] || install -o root -g "$group" -m 0664 "$manifest" "$target_manifest"
                rm -f -- "$manifest"
            else
                note "migration retained source $user/$name: no matching appmanifest found"
                rm -rf -- "$dest"
                ((skipped+=1)); continue
            fi
            rm -rf -- "$game"
            ((migrated+=1))
        done < <(find "$source/common" -mindepth 1 -maxdepth 1 -type d -print0)
    done < <(enrolled_users)
    note "migration complete: $migrated game directory/directories moved; $skipped skipped"
}

cmd_users() {
    local action=${1:-} user=${2:-} library
    case "$action" in
        list)
            while IFS=: read -r name _ uid _ _ home shell; do
                valid_user "$name" || continue
                if id -nG "$name" | grep -qw "$group"; then
                    if steam_initialized_for "$name"; then state=steam-ready; else state=needs-steam-login; fi
                    printf 'enrolled\t%s\t%s\t%s\n' "$name" "$home" "$state"
                else
                    printf 'available\t%s\t%s\t-\n' "$name" "$home"
                fi
            done < <(getent passwd)
            ;;
        enroll)
            require_root; [[ -n "$user" ]] || die "usage: ludusctl users enroll <user>"
            valid_user "$user" || die "not an eligible local interactive user: $user"
            steam_running_for "$user" && die "Steam is running for $user. Ask them to sign out before enrolling them."
            assert_steam_stopped; ensure_config; ensure_group
            usermod -aG "$group" "$user"
            while IFS= read -r library; do prepare_user_private_dirs "$user" "$library"; done < <(library_paths)
            note "enrolled $user; they must sign out and sign back in before Steam can use group access"
            note "shared libraries are registered in Steam automatically when Ludus next launches it"
            ;;
        remove)
            require_root; [[ -n "$user" ]] || die "usage: ludusctl users remove <user>"
            getent passwd "$user" >/dev/null || die "unknown user: $user"
            assert_steam_stopped
            gpasswd -d "$user" "$group" >/dev/null 2>&1 || true
            note "removed $user from Ludus; no home-directory or game data was deleted"
            ;;
        *) die "usage: ludusctl users list|enroll|remove" ;;
    esac
}

cmd_libraries() {
    local action=${1:-} raw=${2:-} extra=${3:-} library found=false
    case "$action" in
        list) library_paths | while IFS= read -r library; do printf '%s\t%s\n' "$(library_id "$library")" "$library"; done ;;
        candidates) library_candidates ;;
        add)
            require_root; [[ -n "$raw" ]] || die "usage: ludusctl libraries add <absolute-path>"
            assert_steam_stopped; ensure_config; ensure_group; library=$(canonical_path "$raw")
            while IFS= read -r path; do [[ "$path" == "$library" ]] && die "library is already configured: $library"; done < <(library_paths)
            prepare_library "$library"
            printf '%s\n' "$library" >> "$libraries_file"
            while IFS= read -r user; do prepare_user_private_dirs "$user" "$library"; done < <(enrolled_users)
            note "added shared library: $library; each user's Steam config is updated at their next Ludus launch"
            ;;
        add-default)
            require_root; [[ -n "$raw" ]] || die "usage: ludusctl libraries add-default <mounted-path>"
            assert_steam_stopped; ensure_config; ensure_group; add_default_library "$raw"
            ;;
        remove)
            require_root; [[ -n "$raw" ]] || die "usage: ludusctl libraries remove <path>"
            assert_steam_stopped; ensure_config; library=$(canonical_path "$raw")
            while IFS= read -r path; do [[ "$path" == "$library" ]] && found=true; done < <(library_paths)
            "$found" || die "library is not configured: $library"
            tmp=$(mktemp "$config_dir/libraries.XXXXXX")
            while IFS= read -r path; do [[ "$path" == "$library" ]] || printf '%s\n' "$path" >> "$tmp"; done < <(library_paths)
            install -m 0644 "$tmp" "$libraries_file"; rm -f "$tmp"
            note "removed $library from Ludus management; no games or private data were deleted"
            ;;
        check)
            local result=0; while IFS= read -r library; do check_library "$library" || result=1; done < <(library_paths); return "$result"
            ;;
        repair)
            require_root; assert_steam_stopped; while IFS= read -r library; do repair_library "$library"; done < <(library_paths)
            ;;
        migrate)
            [[ -n "$raw" ]] || die "usage: ludusctl libraries migrate <configured-path> [--yes]"
            library=$(canonical_path "$raw")
            while IFS= read -r path; do [[ "$path" == "$library" ]] && found=true; done < <(library_paths)
            "$found" || die "library is not configured: $library"
            migrate_library "$library" "$extra"
            ;;
        *) die "usage: ludusctl libraries list|candidates|add|add-default|remove|check|repair|migrate" ;;
    esac
}

cmd_doctor() {
    local result=0 user service
    getent group "$group" >/dev/null && echo "HEALTHY group $group exists" || { echo "ERROR group $group is missing"; result=1; }
    [[ -x /usr/bin/bazzite-steam ]] && echo "HEALTHY Bazzite Steam launcher found" || { echo "ERROR /usr/bin/bazzite-steam is missing"; result=1; }
    [[ -f "$libraries_file" ]] && echo "HEALTHY library configuration found" || echo "WARNING no shared libraries configured"
    for service in ludus.service ludus-mount.service ludus-backend.service ludus-web.service ludus-web-firewall.service; do
        if systemctl is-active --quiet "$service"; then
            echo "HEALTHY $service is active"
        elif systemctl is-enabled --quiet "$service" 2>/dev/null; then
            echo "WARNING $service is enabled but inactive"
        else
            echo "WARNING $service is not enabled"
        fi
    done
    [[ -S /run/ludus/mount.sock ]] && echo "HEALTHY mount control socket exists" || { echo "WARNING mount control socket is unavailable"; result=1; }
    [[ -S /run/ludus/backend.sock ]] && echo "HEALTHY WebUI backend socket exists" || echo "WARNING WebUI backend socket is unavailable"
    [[ -r /etc/ludus/webui.json ]] && echo "HEALTHY WebUI credential configuration found" || echo "WARNING WebUI credential configuration is unavailable"
    if command -v firewall-cmd >/dev/null 2>&1 && firewall-cmd --state >/dev/null 2>&1; then
        firewall-cmd --zone=ludus --query-port=9876/tcp >/dev/null 2>&1 && echo "HEALTHY WebUI firewall port is limited to the Ludus zone" || echo "WARNING WebUI firewall port is not open in the Ludus zone"
    else
        echo "WARNING firewalld is unavailable; WebUI LAN access could not be constrained"
    fi
    cmd_libraries check || result=1
    while IFS= read -r user; do valid_user "$user" || { echo "ERROR enrolled user is no longer eligible: $user"; result=1; }; done < <(enrolled_users)
    return "$result"
}

case "${1:-}" in
    status|doctor) cmd_doctor ;;
    users) shift; cmd_users "$@" ;;
    libraries) shift; cmd_libraries "$@" ;;
    repair) shift; cmd_libraries repair "$@" ;;
    disks) shift; require_root; "$disks" "$@" ;;
    -h|--help|help|'') usage ;;
    *) die "unknown command: $1" ;;
esac
