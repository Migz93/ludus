#!/usr/bin/env bash
set -Eeuo pipefail
# This is Bazzite Desktop, so the user session must be a normal Plasma Wayland
# session.  Do not let Plasma's own branded splash replace the Ludus cover.
# The runtime mask dies with the user manager at logout, so normal Plasma use
# outside this dedicated Ludus session is unaffected.
systemctl --user mask --runtime plasma-ksplash.service >/dev/null 2>&1 || true

# A first-time Steam user needs the normal client to create loginusers.vdf.
# Start it automatically after Plasma/Xwayland is ready, but leave the desktop
# available for its account setup. Later sessions use the Ludus cover and Big
# Picture path below.
if [[ -s "$HOME/.local/share/Steam/config/loginusers.vdf" ]]; then
    # The overlay waits for its Wayland socket, covers startup, and launches
    # Steam Big Picture once it can connect.
    /usr/local/lib/ludus/ludus-overlay &
else
    /usr/local/lib/ludus/ludus-steam --first-run &
fi
exec /usr/libexec/plasma-dbus-run-session-if-needed /usr/bin/startplasma-wayland
