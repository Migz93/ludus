module ludus_controller 1.0;

require {
    attribute domain;
    attribute exec_type;
    attribute file_type;
    role system_r;
    type init_t;
    type event_device_t;
    type proc_t;
    class dir { getattr open read search };
    class file { entrypoint execute getattr map open read };
    class chr_file { getattr ioctl open read write };
    class process transition;
    class process2 nnp_transition;
}

# The bridge is deliberately a separate domain.  It only reads physical input
# devices, creates its virtual keyboard through uinput, and reads /proc/*/comm
# to avoid emitting keys outside the Plasma Login greeter.
type ludus_controller_t;
type ludus_controller_exec_t;
typeattribute ludus_controller_t domain;
typeattribute ludus_controller_exec_t file_type;
typeattribute ludus_controller_exec_t exec_type;
role system_r types ludus_controller_t;

allow init_t ludus_controller_exec_t:file { execute getattr map open read };
allow init_t ludus_controller_t:process transition;
# systemd's NoNewPrivileges setting requires an explicit policy exception for
# this deliberately confined transition.  Do not permit execute_no_trans:
# the bridge must never run in init_t instead of ludus_controller_t.
allow init_t ludus_controller_t:process2 nnp_transition;
type_transition init_t ludus_controller_exec_t:process ludus_controller_t;

allow ludus_controller_t ludus_controller_exec_t:file { entrypoint execute getattr map open read };
# Current Fedora/Bazzite policy labels both physical event devices and uinput
# as event_device_t.  Device-node ownership still prevents non-root access;
# this domain is limited to the event-device operations required to relay a
# controller as a virtual keyboard.
allow ludus_controller_t event_device_t:dir search;
allow ludus_controller_t event_device_t:chr_file { getattr ioctl open read write };
allow ludus_controller_t proc_t:dir { getattr open read search };
allow ludus_controller_t proc_t:file { getattr open read };
