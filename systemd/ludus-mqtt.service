[Unit]
Description=Ludus Home Assistant MQTT integration
After=network-online.target plasmalogin.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/lib/ludus/ludus-mqtt
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
ReadWritePaths=/run/ludus /run/ludus-mount

[Install]
WantedBy=multi-user.target
