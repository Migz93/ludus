#!/usr/bin/env bash
# Ludus shared-library administration.  SPDX-License-Identifier: GPL-3.0-or-later
set -Eeuo pipefail

config_dir=/etc/ludus
libraries_file="$config_dir/libraries.conf"
default_library_file="$config_dir/default-library.conf"
webui_config="$config_dir/webui.json"
mqtt_config="$config_dir/mqtt.json"
mqtt_status=/run/ludus/mqtt-status.json
group=ludus
disks=/usr/local/lib/ludus/ludus-disks
user_libraries=/usr/local/lib/ludus/ludus-steam-user-libraries
storage_report=/usr/local/lib/ludus/ludus-storage
steam_register=/usr/local/lib/ludus/ludus-steam-register-libraries

die() { echo "ludusctl: $*" >&2; exit 1; }
note() { echo "ludusctl: $*"; }
require_root() { (( EUID == 0 )) || die "this operation must be run as root"; }

# Diagnostics are emitted through report() so the same checks can be printed as
# the long-standing "SEVERITY message" lines or as structured records.  The
# human-readable text is the message field verbatim, so the two never diverge.
doctor_json=false
doctor_records=()

report() { # severity code group subject data message
    local severity=$1 code=$2 group=$3 subject=$4 data=$5 message=$6
    if "$doctor_json"; then
        doctor_records+=("$severity"$'\t'"$code"$'\t'"$group"$'\t'"${subject//$'\t'/ }"$'\t'"${data//$'\t'/ }"$'\t'"${message//$'\t'/ }")
    else
        printf '%s %s\n' "$severity" "$message"
    fi
}

emit_doctor_json() {
    (( ${#doctor_records[@]} )) || { echo '[]'; return; }
    printf '%s\n' "${doctor_records[@]}" | python3 -c '
import json, sys
records = []
for line in sys.stdin.read().split("\n"):
    if not line:
        continue
    severity, code, group, subject, data, message = line.split("\t", 5)
    fields = {}
    for pair in data.split("|"):
        if "=" in pair:
            key, value = pair.split("=", 1)
            fields[key] = value
    records.append({"severity": severity, "code": code, "group": group,
                    "subject": subject, "data": fields, "message": message})
print(json.dumps(records))
'
}

usage() {
    cat <<'EOF'
Usage: ludusctl <command>

  status | doctor [--json]
  storage
  users list | users personal-libraries | users remove-personal-library <user> <path>
  users enroll <user> | users remove <user>
  libraries list | libraries candidates | libraries add <absolute-path>
  libraries add-default <mounted-path> | libraries remove <path>
  libraries default | libraries set-default <configured-path>
  libraries label <configured-path> <label>
  libraries check | libraries repair
  repair
  disks list | disks mount <unmounted-partition> [mount-point]
EOF
}

ensure_config() {
    install -d -m 0755 "$config_dir"
    [[ -e "$libraries_file" ]] || install -m 0644 /dev/null "$libraries_file"
}

disable_steam_autostart() {
    # Steam's desktop autostart would race the Ludus session launcher.  Record
    # exactly which account we changed so uninstall can restore its original
    # file (or remove the file if Ludus created it).
    local user=$1 home_dir autostart_file state backups
    home_dir=$(getent passwd "$user" | cut -d: -f6)
    [[ -n "$home_dir" && -d "$home_dir" ]] || die "cannot find a home directory for $user"
    state="$config_dir/steam-autostart-users"
    backups="$config_dir/steam-autostart-backups"
    install -d -m 0700 "$backups"
    install -d -o "$user" -g "$(id -gn "$user")" -m 0755 "$home_dir/.config/autostart"
    autostart_file="$home_dir/.config/autostart/steam.desktop"
    if ! grep -Fqx "$user"$'\t'"$home_dir" "$state" 2>/dev/null; then
        if [[ -f "$autostart_file" ]]; then
            install -d -m 0700 "$backups/$user"
            cp -a -- "$autostart_file" "$backups/$user/steam.desktop"
        fi
        printf '%s\t%s\n' "$user" "$home_dir" >> "$state"
    fi
    printf '%s\n' '[Desktop Entry]' 'Hidden=true' > "$autostart_file"
    chown "$user:$(id -gn "$user")" "$autostart_file"
    chmod 0644 "$autostart_file"
}

restore_steam_autostart() {
    local user=$1 home_dir autostart_file state backups preserved temporary
    home_dir=$(getent passwd "$user" | cut -d: -f6)
    [[ -n "$home_dir" && -d "$home_dir" ]] || return 0
    state="$config_dir/steam-autostart-users"
    backups="$config_dir/steam-autostart-backups"
    grep -Fqx "$user"$'\t'"$home_dir" "$state" 2>/dev/null || return 0
    autostart_file="$home_dir/.config/autostart/steam.desktop"
    preserved="$backups/$user/steam.desktop"
    if [[ -f "$preserved" ]]; then
        install -d -o "$user" -g "$(id -gn "$user")" -m 0755 "$home_dir/.config/autostart"
        cp -a -- "$preserved" "$autostart_file"
    else
        rm -f "$autostart_file"
    fi
    temporary=$(mktemp "$state.XXXXXX")
    awk -F '\t' -v user="$user" -v home="$home_dir" '$1 != user || $2 != home { print }' "$state" > "$temporary"
    chmod 0600 "$temporary"
    mv -f "$temporary" "$state"
    rm -rf -- "$backups/$user"
}

canonical_path() {
    local path=$1
    [[ "$path" == /* ]] || die "library paths must be absolute"
    [[ "$path" != *$'\n'* && "$path" != *$'\r'* ]] || die "library paths cannot contain line breaks"
    [[ -d "$path" ]] || die "library path does not exist: $path"
    realpath -e -- "$path"
}

# An existing library is deliberately accepted for migrations, but it must be
# game storage—not an OS or user-data directory.  `prepare_library` changes
# ownership and mode of the chosen directory, and `repair` recurses through
# it, so merely requiring an absolute directory is not a safe boundary.
safe_existing_library_path() {
    local library=$1 candidate_target candidate_source candidate_fstype candidate_default allowed=false var_library_root=/var/srv/steam-library
    library=$(canonical_path "$library")
    # /var is an OS-managed Bazzite filesystem, so it has one explicit Ludus
    # storage root. Other candidates are independently mounted filesystems.
    [[ "$library" == "$var_library_root" || "$library" == "$var_library_root"/* ]] && { printf '%s\n' "$library"; return; }
    # Existing-library migrations are allowed only below a non-/var writable
    # local mount presented by the disk picker. This excludes the OS root and
    # all of its managed trees such as /var/log and /var/lib.
    while IFS=$'\t' read -r candidate_target candidate_source candidate_fstype candidate_default; do
        [[ "$candidate_target" == /var ]] && continue
        if [[ "$library" == "$candidate_target"/* ]]; then
            allowed=true
            break
        fi
    done < <(library_candidates)
    "$allowed" || die "library must be below /var/srv/steam-library or a supported non-system local filesystem mount"
    printf '%s\n' "$library"
}

library_paths() {
    [[ -f "$libraries_file" ]] || return 0
    while IFS= read -r path || [[ -n "$path" ]]; do
        [[ -z "$path" || "$path" == \#* ]] && continue
        printf '%s\n' "$path"
    done < "$libraries_file"
}

default_library() { [[ -s "$default_library_file" ]] && head -n1 "$default_library_file" || true; }

library_id() { printf '%s' "$1" | sha256sum | cut -c1-16; }

library_label() {
    local library=$1 marker="$1/libraryfolder.vdf"
    [[ -f "$marker" ]] || return 0
    awk -F'"' '$2 == "label" { print $4; exit }' "$marker"
}

valid_library_label() {
    local label=$1
    [[ ${#label} -le 64 && "$label" != *$'\n'* && "$label" != *$'\r'* && "$label" != *'"'* && "$label" != *'\\'* ]]
}

library_content_id() {
    local library=$1 marker="$1/libraryfolder.vdf"
    [[ -f "$marker" ]] || return 0
    awk -F'"' '$2 == "contentid" { print $4; exit }' "$marker"
}

new_library_content_id() {
    local candidate existing
    command -v shuf >/dev/null || die "shuf is required to create a Steam library identifier"
    while :; do
        # Steam accepts a positive numeric ID stored locally in libraryfolder.vdf.
        # Stay within signed 64-bit range and avoid an ID already used by Ludus.
        candidate=$(shuf -i 1000000000000000000-8999999999999999999 -n 1)
        existing=false
        while IFS= read -r library; do
            [[ "$(library_content_id "$library")" == "$candidate" ]] && { existing=true; break; }
        done < <(library_paths)
        "$existing" || { printf '%s\n' "$candidate"; return; }
    done
}

ensure_library_marker() {
    local library=$1 marker="$1/libraryfolder.vdf" content_id label
    if [[ ! -e "$marker" ]]; then
        content_id=$(new_library_content_id)
        install -o root -g "$group" -m 0664 /dev/null "$marker"
        printf '"libraryfolder"\n{\n\t"contentid"\t\t"%s"\n\t"label"\t\t""\n}\n' "$content_id" > "$marker"
        chown root:"$group" "$marker"; chmod 0664 "$marker"; chmod a-s "$marker"
        return
    fi
    [[ -f "$marker" ]] || die "$marker exists but is not a regular file"
    content_id=$(library_content_id "$library"); label=$(library_label "$library")
    [[ "$content_id" =~ ^[1-9][0-9]*$ ]] || die "$marker has no valid positive numeric content ID"
    valid_library_label "$label" || die "$marker has an unsafe Steam library label"
    chown root:"$group" "$marker"; chmod 0664 "$marker"; chmod a-s "$marker"
}

# A normal WebUI choice is a mounted local filesystem.  Keep the generated
# game directory predictable, but do not create it until the administrator
# explicitly chooses that filesystem.
library_candidates() {
    local target source fstype options default seen='|'
    while read -r target source fstype options; do
        [[ "$source" == /dev/* && ( "$options" == rw,* || "$options" == *,rw,* ) ]] || continue
        # Bazzite exposes several btrfs subvolumes. /var is the one persistent
        # OS-managed choice; presenting /etc, /boot, or a Ludus bind mount as a
        # "disk" would be both confusing and unsafe.
        [[ "$target" == /boot || "$target" == /etc || "$target" == /sysroot* || "$target" == */steamapps/compatdata || "$target" == */steamapps/shadercache ]] && continue
        [[ "$source" != *'['* || "$target" == /var ]] || continue
        if [[ "$target" == /var ]]; then default=/var/srv/steam-library; else default="$target/steam-library"; fi
        [[ "$seen" == *"|$target|"* ]] && continue; seen+="$target|"
        printf '%s\t%s\t%s\t%s\n' "$target" "$source" "$fstype" "$default"
    done < <(findmnt -rn -t btrfs,ext4,xfs -o TARGET,SOURCE,FSTYPE,OPTIONS)
}

add_default_library() {
    local mount=$1 target source fstype default
    while IFS=$'\t' read -r target source fstype default; do
        [[ "$target" == "$mount" ]] || continue
        install -d -o root -g "$group" -m 2775 "$default"
        cmd_libraries add "$default"
        return
    done < <(library_candidates)
    die "not a supported writable local filesystem mount: $mount"
}

user_home() { getent passwd "$1" | awk -F: '{print $6}'; }
user_uid() { getent passwd "$1" | awk -F: '{print $3}'; }
user_primary_group() { id -gn "$1"; }

steam_initialized_for() {
    local user=$1 home
    home=$(user_home "$user")
    # loginusers.vdf is written only after Steam has accepted an account login.
    # This is the safe point at which Ludus may edit that user's VDF files.
    if (( EUID == 0 )); then
        runuser -u "$user" -- test -s "$home/.local/share/Steam/config/loginusers.vdf"
    elif [[ "$(id -un)" == "$user" ]]; then
        test -s "$home/.local/share/Steam/config/loginusers.vdf"
    else
        return 1
    fi
}

valid_user() {
    local user=$1 uid home shell uid_min
    IFS=: read -r _ _ uid _ _ home shell < <(getent passwd "$user") || return 1
    uid_min=$(awk '/^UID_MIN[[:space:]]/{print $2; exit}' /etc/login.defs 2>/dev/null || true)
    uid_min=${uid_min:-1000}
    # Fedora Atomic/Bazzite commonly places homes under /var/home; conventional
    # Fedora installations use /home.  Both are real interactive-user homes.
    [[ "$uid" =~ ^[0-9]+$ && "$uid" -ge "$uid_min" && ( "$home" == /home/* || "$home" == /var/home/* ) && -d "$home" ]]
}

steam_running_for() {
    local user=$1 uid
    uid=$(user_uid "$user")
    pgrep -u "$uid" -f '(^|/)(steam|steamwebhelper|bazzite-steam)( |$)' >/dev/null 2>&1
}

# ludus-steam is the wrapper that requests the private-data mount, launches
# Steam, and waits for it; it is alive for the whole session, including the
# window after mounting but before Steam itself becomes visible to pgrep.
# steam_running_for alone would treat that window as "nobody playing" and
# let reconcile_active_session below tear down a session that is still
# legitimately starting.
ludus_steam_running_for() {
    local user=$1 uid
    uid=$(user_uid "$user")
    [[ -n "$uid" ]] || return 1
    pgrep -u "$uid" -f '(^|/)ludus-steam( |$)' >/dev/null 2>&1
}

# ludus-steam's own EXIT trap is the only thing that normally clears the
# active-session marker and unmounts the private binds; it only runs if the
# script exits gracefully. A crash or a forced session end skips it and
# leaves both stuck. Clear a marker that no longer has a matching process,
# using the exact same unmount steps a normal sign-out performs, so a stale
# marker never keeps player/library changes blocked or misreports as an
# active session.
reconcile_active_session() {
    local active_user library target name
    [[ -r /run/ludus-mount/active-user ]] || return 0
    active_user=$(< /run/ludus-mount/active-user)
    [[ -n "$active_user" ]] || return 0
    steam_running_for "$active_user" && return 0
    ludus_steam_running_for "$active_user" && return 0
    while IFS= read -r library; do
        for name in compatdata shadercache; do
            target="$library/steamapps/$name"
            mountpoint -q "$target" 2>/dev/null && umount "$target" 2>/dev/null
        done
    done < <(library_paths)
    rm -f /run/ludus-mount/active-user 2>/dev/null
    report WARNING session.reconciled private "$active_user" '' "cleared a stale session marker for $active_user; no matching Steam process was found"
}

assert_steam_stopped() {
    local user running=()
    while IFS= read -r user; do
        steam_running_for "$user" && running+=("$user")
    done < <(enrolled_users)
    ((${#running[@]} == 0)) || die "Steam is running for: ${running[*]}. Ask them to sign out before changing libraries."
}

enrolled_users() {
    getent group "$group" | awk -F: '{gsub(/,/, "\n", $4); print $4}' | sed '/^$/d'
}

ensure_group() { getent group "$group" >/dev/null || groupadd --system "$group"; }

private_dir() {
    local user=$1 library=$2 name=$3 home id
    home=$(user_home "$user"); id=$(library_id "$library")
    printf '%s/.local/share/ludus/steam-libraries/%s/%s\n' "$home" "$id" "$name"
}

prepare_user_private_dirs() {
    local user=$1 library=$2 name dir home primary_group parent
    home=$(user_home "$user")
    primary_group=$(user_primary_group "$user")
    # install -d assigns ownership only to the final component.  Create these
    # standard per-user parents explicitly so a first-time Steam user never
    # receives root-owned ~/.local/share and cannot bootstrap the client.
    for parent in "$home/.local" "$home/.local/share" "$home/.local/share/ludus" "$home/.local/share/ludus/steam-libraries"; do
        [[ ! -L "$parent" ]] || die "$parent must not be a symlink"
        if [[ -e "$parent" ]]; then
            [[ -d "$parent" ]] || die "$parent exists but is not a directory"
            # These are per-user paths.  Correct a root-owned intermediate
            # left by an older Ludus install without changing the user's mode.
            chown "$user:$primary_group" "$parent"
        elif [[ "$parent" == "$home/.local/share/ludus" || "$parent" == "$home/.local/share/ludus/steam-libraries" ]]; then
            install -d -o "$user" -g "$primary_group" -m 0700 "$parent"
        else
            install -d -o "$user" -g "$primary_group" -m 0755 "$parent"
        fi
    done
    for name in compatdata shadercache; do
        dir=$(private_dir "$user" "$library" "$name")
        install -d -o "$user" -g "$primary_group" -m 0700 "$dir"
    done
}

# The private bind targets must be empty because changing a populated target
# would silently hide player data.
prepare_library() {
    local library=$1 apps target name user
    # Group permissions on the library itself are insufficient if one of its
    # ancestors is private (for example /var/lib/ludus). Validate only players
    # who have completed their first Steam login; the rest are deliberately
    # deferred until their Steam configuration exists.
    while IFS= read -r user; do
        steam_initialized_for "$user" || continue
        runuser -u "$user" -- test -x "$library" || die "$user cannot traverse $library; choose a path accessible to all Ludus users"
    done < <(enrolled_users)
    apps="$library/steamapps"
    install -d -o root -g "$group" -m 2775 "$library" "$apps" \
        "$apps/common" "$apps/workshop"
    ensure_library_marker "$library"
    for name in compatdata shadercache; do
        target="$apps/$name"
        if [[ -e "$target" && ! -d "$target" ]]; then
            die "$target exists but is not a directory"
        fi
        if [[ -d "$target" ]] && find "$target" -mindepth 1 -maxdepth 1 -print -quit | grep -q .; then
            die "$target contains existing data; choose an empty shared-library directory"
        fi
        install -d -o root -g root -m 000 "$target"
        # A setgid parent can cause new directories to inherit its setgid bit
        # even when install is given mode 000.  Locked bind targets must have
        # no permissions or special bits while unmounted.
        chmod g-s "$target"
        chmod 000 "$target"
    done
}

check_library() {
    local library=$1 apps actual errors=0 name target user active_user=''
    apps="$library/steamapps"
    [[ -d "$library" ]] || { report ERROR library.missing storage "$library" '' "library missing: $library"; return 1; }
    actual=$(stat -c '%U:%G %a' "$library")
    [[ "$actual" == "root:$group 2775" ]] || { report WARNING library.permissions storage "$library" "actual=$actual|expected=root:$group 2775" "$library permissions are $actual; expected root:$group 2775"; ((errors+=1)); }
    for name in common workshop; do
        [[ -d "$apps/$name" ]] || { report ERROR library.folder-missing storage "$apps/$name" "library=$library" "missing $apps/$name"; ((errors+=1)); }
    done
    for name in compatdata shadercache; do
        target="$apps/$name"
        [[ -d "$target" ]] || { report ERROR bind.missing private "$target" '' "missing private bind target $target"; ((errors+=1)); continue; }
        if [[ "$(findmnt -rn -o TARGET -T "$target" 2>/dev/null | head -n1)" == "$target" ]]; then
            if [[ -r /run/ludus-mount/active-user ]]; then active_user=$(< /run/ludus-mount/active-user); fi
            if [[ -n "$active_user" ]] && valid_user "$active_user"; then
                report HEALTHY bind.mounted private "$target" "user=$active_user" "$target has an active private bind mount for $active_user"
            else
                report WARNING bind.mounted private "$target" '' "$target has an active bind mount without a valid Ludus player session"
            fi
        else
            actual=$(stat -c '%U:%G %a' "$target")
            [[ "$actual" == "root:root 0" ]] || { report ERROR bind.permissions private "$target" "actual=$actual" "$target permissions are $actual; expected root:root 0"; ((errors+=1)); }
        fi
    done
    # The library itself can have perfect ownership while a parent mount point
    # is private to one player. Test the complete traversal and write path for
    # every enrolled player, which is the view Steam will actually have.
    if (( EUID == 0 )); then
        while IFS= read -r user; do
            if runuser -u "$user" -- test -x "$library" && runuser -u "$user" -- test -w "$apps"; then
                report HEALTHY library.user-access storage "$library" "user=$user" "$user can access the shared Steam library $library"
            else
                report ERROR library.user-inaccessible storage "$library" "user=$user" "$user cannot access the shared Steam library $library; check parent-directory ownership and permissions"
                ((errors+=1))
            fi
        done < <(enrolled_users)
    else
        report WARNING library.access-unverified storage "$library" '' "cannot verify every enrolled player's access to $library without root privileges"
    fi
    return "$errors"
}

repair_library() {
    local library=$1 apps path
    prepare_library "$library"
    apps="$library/steamapps"
    # Do not traverse other mounted filesystems or touch the private bind targets.
    # Steam Runtime can expose read-only bind mounts beneath a library.  Skip
    # those (and symlinks) but continue repairing the actual shared content,
    # including Steam-created download directories.
    while IFS= read -r -d '' path; do
        [[ -L "$path" ]] && continue
        chgrp --no-dereference "$group" "$path" 2>/dev/null || continue
        chmod g+rwX "$path" 2>/dev/null || true
        [[ -d "$path" ]] && chmod g+s "$path" 2>/dev/null || true
    done < <(find "$library" -xdev \( -path "$apps/compatdata" -o -path "$apps/shadercache" \) -prune -o -print0)
    # A setgid library root can make the marker inherit a setgid bit. It is a
    # regular metadata file, not a shared executable, so keep only group write.
    chmod g-s "$library/libraryfolder.vdf" 2>/dev/null || true
}

cmd_users() {
    local action=${1:-} user=${2:-} library path users=()
    case "$action" in
        list)
            while IFS=: read -r name _ uid _ _ home shell; do
                valid_user "$name" || continue
                if id -nG "$name" | grep -qw "$group"; then
                    if steam_initialized_for "$name"; then state=steam-ready; else state=needs-steam-login; fi
                    printf 'enrolled\t%s\t%s\t%s\n' "$name" "$home" "$state"
                else
                    printf 'available\t%s\t%s\t-\n' "$name" "$home"
                fi
            done < <(getent passwd)
            ;;
        personal-libraries)
            require_root
            while IFS= read -r user; do
                steam_initialized_for "$user" && users+=("$user")
            done < <(enrolled_users)
            ((${#users[@]})) && "$user_libraries" list-many "${users[@]}" || echo '[]'
            ;;
        remove-personal-library)
            require_root; path=${3:-}
            [[ -n "$user" && -n "$path" ]] || die "usage: ludusctl users remove-personal-library <user> <path>"
            valid_user "$user" && id -nG "$user" | grep -qw "$group" || die "not an enrolled Ludus user: $user"
            steam_initialized_for "$user" || die "$user has not completed their first Steam login"
            assert_steam_stopped
            "$user_libraries" remove "$user" "$path"
            ;;
        enroll)
            require_root; [[ -n "$user" ]] || die "usage: ludusctl users enroll <user>"
            valid_user "$user" || die "not an eligible local interactive user: $user"
            steam_running_for "$user" && die "Steam is running for $user. Ask them to sign out before enrolling them."
            assert_steam_stopped; ensure_config; ensure_group
            usermod -aG "$group" "$user"
            disable_steam_autostart "$user"
            if steam_initialized_for "$user"; then
                while IFS= read -r library; do prepare_user_private_dirs "$user" "$library"; done < <(library_paths)
            else
                note "deferred Steam library setup for $user until their first Steam login"
            fi
            note "enrolled $user; they must sign out and sign back in before Steam can use group access"
            note "shared libraries are registered in Steam automatically when Ludus next launches it"
            ;;
        remove)
            require_root; [[ -n "$user" ]] || die "usage: ludusctl users remove <user>"
            getent passwd "$user" >/dev/null || die "unknown user: $user"
            assert_steam_stopped
            gpasswd -d "$user" "$group" >/dev/null 2>&1 || true
            restore_steam_autostart "$user"
            note "removed $user from Ludus; no home-directory or game data was deleted"
            ;;
        *) die "usage: ludusctl users list|personal-libraries|remove-personal-library|enroll|remove" ;;
    esac
}

cmd_libraries() {
    local action=${1:-} raw=${2:-} extra=${3:-} library found=false
    case "$action" in
        list) library_paths | while IFS= read -r library; do printf '%s\t%s\t%s\n' "$(library_id "$library")" "$library" "$(library_label "$library")"; done ;;
        default) default_library ;;
        candidates) library_candidates ;;
        add)
            require_root; [[ -n "$raw" ]] || die "usage: ludusctl libraries add <absolute-path>"
            assert_steam_stopped; ensure_config; ensure_group; library=$(safe_existing_library_path "$raw")
            while IFS= read -r path; do [[ "$path" == "$library" ]] && die "library is already configured: $library"; done < <(library_paths)
            prepare_library "$library"
            printf '%s\n' "$library" >> "$libraries_file"
            while IFS= read -r user; do
                if steam_initialized_for "$user"; then
                    prepare_user_private_dirs "$user" "$library"
                else
                    note "deferred Steam library setup for $user until their first Steam login"
                fi
            done < <(enrolled_users)
            note "added shared library: $library; each user's Steam config is updated at their next Ludus launch"
            ;;
        add-default)
            require_root; [[ -n "$raw" ]] || die "usage: ludusctl libraries add-default <mounted-path>"
            assert_steam_stopped; ensure_config; ensure_group; add_default_library "$raw"
            ;;
        remove)
            require_root; [[ -n "$raw" ]] || die "usage: ludusctl libraries remove <path>"
            assert_steam_stopped; ensure_config; library=$(canonical_path "$raw")
            while IFS= read -r path; do [[ "$path" == "$library" ]] && found=true; done < <(library_paths)
            "$found" || die "library is not configured: $library"
            tmp=$(mktemp "$config_dir/libraries.XXXXXX")
            while IFS= read -r path; do [[ "$path" == "$library" ]] || printf '%s\n' "$path" >> "$tmp"; done < <(library_paths)
            install -m 0644 "$tmp" "$libraries_file"; rm -f "$tmp"
            [[ "$(default_library)" == "$library" ]] && rm -f "$default_library_file"
            note "removed $library from Ludus management; no games or private data were deleted"
            ;;
        set-default)
            require_root; [[ -n "$raw" ]] || die "usage: ludusctl libraries set-default <configured-path>"
            assert_steam_stopped; library=$(canonical_path "$raw")
            while IFS= read -r path; do [[ "$path" == "$library" ]] && found=true; done < <(library_paths)
            "$found" || die "library is not configured: $library"
            tmp=$(mktemp "$config_dir/default-library.XXXXXX")
            printf '%s\n' "$library" > "$tmp"; install -m 0644 "$tmp" "$default_library_file"; rm -f "$tmp"
            note "recorded Ludus preferred shared library: $library; Steam's per-user default remains controlled by Steam's Storage UI"
            ;;
        label)
            require_root; [[ -n "$raw" ]] || die "usage: ludusctl libraries label <configured-path> <label>"
            assert_steam_stopped; library=$(canonical_path "$raw")
            while IFS= read -r path; do [[ "$path" == "$library" ]] && found=true; done < <(library_paths)
            "$found" || die "library is not configured: $library"
            valid_library_label "$extra" || die "library labels must be at most 64 characters and cannot contain quotes, backslashes, or line breaks"
            "$user_libraries" set-shared-library-label "$library" "$extra"
            while IFS= read -r user; do
                steam_initialized_for "$user" || continue
                "$user_libraries" set-library-label "$user" "$library" "$extra"
            done < <(enrolled_users)
            note "updated shared Steam library label: $library"
            ;;
        check)
            local result=0; while IFS= read -r library; do check_library "$library" || result=1; done < <(library_paths); return "$result"
            ;;
        repair)
            require_root; assert_steam_stopped; while IFS= read -r library; do repair_library "$library"; done < <(library_paths)
            ;;
        *) die "usage: ludusctl libraries list|candidates|add|add-default|remove|default|set-default|label|check|repair" ;;
    esac
}

cmd_doctor() {
    local result=0 user service library name target active_user='' mount_info source fstype expected resolved_source resolved_expected actual zone records severity code subject data message
    [[ "${1:-}" == --json ]] && doctor_json=true
    reconcile_active_session
    getent group "$group" >/dev/null && report HEALTHY group.present services "$group" '' "group $group exists" || { report ERROR group.missing services "$group" '' "group $group is missing"; result=1; }
    [[ -x /usr/bin/bazzite-steam ]] && report HEALTHY steam-launcher.present services /usr/bin/bazzite-steam '' "Bazzite Steam launcher found" || { report ERROR steam-launcher.missing services /usr/bin/bazzite-steam '' "/usr/bin/bazzite-steam is missing"; result=1; }
    [[ -f "$libraries_file" ]] && report HEALTHY library-config.present services "$libraries_file" '' "library configuration found" || report WARNING library-config.absent services "$libraries_file" '' "no shared libraries configured"
    for service in ludus.service ludus-mount.service ludus-backend.service ludus-web.service ludus-web-firewall.service ludus-mqtt.service; do
        if systemctl is-active --quiet "$service"; then
            report HEALTHY service.active services "$service" '' "$service is active"
        elif systemctl is-enabled --quiet "$service" 2>/dev/null; then
            report WARNING service.inactive services "$service" '' "$service is enabled but inactive"
        else
            report WARNING service.disabled services "$service" '' "$service is not enabled"
        fi
    done
    [[ -S /run/ludus-mount/mount.sock ]] && report HEALTHY mount-socket.present services /run/ludus-mount/mount.sock '' "mount control socket exists" || { report WARNING mount-socket.absent services /run/ludus-mount/mount.sock '' "mount control socket is unavailable"; result=1; }
    [[ -S /run/ludus/backend.sock ]] && report HEALTHY backend-socket.present services /run/ludus/backend.sock '' "WebUI backend socket exists" || report WARNING backend-socket.absent services /run/ludus/backend.sock '' "WebUI backend socket is unavailable"
    [[ -r /etc/ludus/webui.json ]] && report HEALTHY webui-config.present services /etc/ludus/webui.json '' "WebUI credential configuration found" || report WARNING webui-config.absent services /etc/ludus/webui.json '' "WebUI credential configuration is unavailable"
    if [[ -r "$mqtt_config" ]]; then
        if python3 -c 'import json, sys; sys.exit(not json.load(open(sys.argv[1])).get("enabled", False))' "$mqtt_config"; then
            report HEALTHY mqtt.enabled network "$mqtt_config" '' "Home Assistant MQTT integration is enabled"
            if [[ -r "$mqtt_status" ]] && python3 -c 'import json, sys; sys.exit(not json.load(open(sys.argv[1])).get("connected", False))' "$mqtt_status"; then
                report HEALTHY mqtt.connected network "$mqtt_status" '' "Home Assistant MQTT broker is connected"
            else
                report WARNING mqtt.disconnected network "$mqtt_status" '' "Home Assistant MQTT broker is not connected"
            fi
        else
            report HEALTHY mqtt.disabled network "$mqtt_config" '' "Home Assistant MQTT integration is disabled"
        fi
    else
        report WARNING mqtt.config-absent network "$mqtt_config" '' "Home Assistant MQTT configuration is unavailable"
    fi
    if command -v firewall-cmd >/dev/null 2>&1 && firewall-cmd --state >/dev/null 2>&1; then
        zone=$(cat /etc/ludus/webui-firewall-zone 2>/dev/null || true)
        if [[ -z "$zone" ]]; then
            report WARNING firewall.zone-unrecorded network '' '' "WebUI firewall zone has not been recorded"
        elif firewall-cmd --zone="$zone" --query-port=9876/tcp >/dev/null 2>&1; then
            report HEALTHY firewall.open network "$zone" 'port=9876/tcp' "WebUI port 9876/tcp is open in active zone $zone"
        else
            report WARNING firewall.closed network "$zone" 'port=9876/tcp' "WebUI port 9876/tcp is not open in recorded zone $zone"
        fi
    else
        report WARNING firewall.unavailable network '' '' "firewalld is unavailable; WebUI LAN access could not be constrained"
    fi
    if [[ -r /run/ludus-mount/active-user ]]; then active_user=$(< /run/ludus-mount/active-user); fi
    [[ -z "$active_user" ]] && report HEALTHY session.idle private '' '' "no Ludus player session has private binds active" || report HEALTHY session.active private "$active_user" '' "private binds are active for $active_user"
    while IFS= read -r library; do
        mount_info=$(findmnt -rn -o SOURCE,FSTYPE -T "$library" 2>/dev/null || true)
        if [[ -n "$mount_info" ]]; then
            read -r source fstype <<< "$mount_info"
            report HEALTHY library.mounted storage "$library" "device=$source|fstype=$fstype" "library mount $library: $source ($fstype)"
        else
            report ERROR library.unresolved storage "$library" '' "library mount cannot be resolved: $library"; result=1
        fi
        for name in compatdata shadercache; do
            target="$library/steamapps/$name"
            if mountpoint -q "$target"; then
                # For a bind on Btrfs, SOURCE contains the backing device plus
                # the subvolume path; FSROOT is the actual private bind source.
                source=$(findmnt -rn -o FSROOT -T "$target" 2>/dev/null || true)
                if [[ -n "$active_user" ]] && valid_user "$active_user"; then
                    expected=$(private_dir "$active_user" "$library" "$name")
                    # Bazzite exposes /home/<user> as an alias of
                    # /var/home/<user>.  findmnt can report either spelling,
                    # so compare the resolved directories rather than issuing
                    # a false isolation error for the same inode.
                    resolved_source=$(readlink -f -- "$source" 2>/dev/null || printf '%s\n' "$source")
                    resolved_expected=$(readlink -f -- "$expected" 2>/dev/null || printf '%s\n' "$expected")
                    [[ "$resolved_source" == "$resolved_expected" ]] && report HEALTHY bind.correct private "$target" "library=$library|source=$source" "private bind $target -> $source" || { report ERROR bind.wrong-target private "$target" "library=$library|source=$source|expected=$expected" "private bind $target points to $source; expected $expected"; result=1; }
                else
                    report WARNING bind.unclaimed private "$target" "library=$library|source=$source" "private bind $target is active ($source), but no valid active player is recorded"
                fi
            else
                actual=$(stat -c '%U:%G %a' "$target" 2>/dev/null || true)
                [[ "$actual" == 'root:root 0' ]] && report HEALTHY bind.locked private "$target" "library=$library" "private bind target $target is locked while idle" || { report ERROR bind.unlocked private "$target" "library=$library|actual=${actual:-missing}" "private bind target $target is not locked (found ${actual:-missing})"; result=1; }
            fi
        done
    done < <(library_paths)
    cmd_libraries check || result=1
    while IFS= read -r user; do
        valid_user "$user" || { report ERROR player.ineligible steam "$user" '' "enrolled user is no longer eligible: $user"; result=1; continue; }
        if steam_running_for "$user"; then
            if [[ "$user" == "$active_user" ]]; then
                report HEALTHY steam.running steam "$user" '' "Steam is running for active player $user"
            else
                report WARNING steam.running steam "$user" '' "Steam is running for $user outside the active Ludus session"
            fi
        else
            report HEALTHY steam.stopped steam "$user" '' "Steam is stopped for $user"
        fi
        if steam_initialized_for "$user"; then
            if "$doctor_json"; then
                records=$("$user_libraries" check-records "$user") || result=1
                while IFS=$'\t' read -r severity code subject data message; do
                    [[ -n "$severity" ]] && report "$severity" "$code" steam "$subject" "$data" "$message"
                done <<< "$records"
            else
                "$user_libraries" check "$user" || result=1
            fi
        else
            report WARNING steam.deferred steam "$user" '' "Steam registration deferred for $user until their first Steam login"
        fi
    done < <(enrolled_users)
    if command -v getenforce >/dev/null 2>&1; then
        case "$(getenforce)" in
            Enforcing) report HEALTHY selinux.enforcing security '' '' "SELinux is enforcing" ;;
            Permissive) report WARNING selinux.permissive security '' '' "SELinux is permissive" ;;
            *) report WARNING selinux.disabled security '' '' "SELinux is disabled" ;;
        esac
        if semodule -l 2>/dev/null | awk '$1 == "ludus_controller" { found=1 } END { exit !found }'; then
            actual=$(ls -Zd /usr/local/lib/ludus/ludus-controller-bridge 2>/dev/null | awk '{print $1}')
            [[ "$actual" == *:ludus_controller_exec_t:* ]] && report HEALTHY selinux.controller-ok security ludus_controller "label=$actual" "controller SELinux policy and executable label are installed" || { report ERROR selinux.controller-mislabelled security ludus_controller "label=${actual:-missing}" "controller executable SELinux label is ${actual:-missing}"; result=1; }
        else
            report ERROR selinux.controller-missing security ludus_controller '' "controller SELinux policy is not installed"; result=1
        fi
        if [[ -r "$webui_config" ]] && python3 -c 'import json, sys; sys.exit(not json.load(open(sys.argv[1])).get("vscode_ssh_forwarding", False))' "$webui_config"; then
            if semodule -l 2>/dev/null | awk '$1 == "ludus_vscode_ssh" { found=1 } END { exit !found }'; then
                report HEALTHY selinux.vscode-ok security ludus_vscode_ssh '' "VS Code Remote SSH forwarding policy is installed"
            else
                report ERROR selinux.vscode-missing security ludus_vscode_ssh '' "VS Code Remote SSH forwarding is enabled in Ludus, but its SELinux policy is not installed"; result=1
            fi
        fi
    else
        report WARNING selinux.unavailable security '' '' "SELinux tools are unavailable; controller policy could not be checked"
    fi
    if "$doctor_json"; then emit_doctor_json; fi
    return "$result"
}

cmd_storage() { "$storage_report"; }

case "${1:-}" in
    status|doctor) shift; cmd_doctor "$@" ;;
    storage) cmd_storage ;;
    users) shift; cmd_users "$@" ;;
    libraries) shift; cmd_libraries "$@" ;;
    repair) shift; cmd_libraries repair "$@" ;;
    disks) shift; require_root; "$disks" "$@" ;;
    -h|--help|help|'') usage ;;
    *) die "unknown command: $1" ;;
esac
