#!/usr/bin/env bash
# Steam's client still uses Xwayland for part of its UI.  The loading cover can
# connect to Wayland before Xwayland is ready, so discover KWin's display and
# cookie and wait until the X server accepts a connection before launching.
set -Eeuo pipefail

ready_file="$XDG_RUNTIME_DIR/ludus-steam-ready"
[[ -e "$ready_file" ]] && unlink "$ready_file"

# The dedicated Ludus session deliberately leaves first-time Steam users at
# their desktop.  Keep this defensive guard as well, so an accidental direct
# invocation cannot open Big Picture before that user has signed in normally.
[[ -s "$HOME/.local/share/Steam/config/loginusers.vdf" ]] || exit 0

for _ in $(seq 1 300); do
    while read -r pid; do
        args=$(tr '\0' '\n' < "/proc/$pid/cmdline" 2>/dev/null || true)
        display=$(printf '%s\n' "$args" | sed -n '/^--xwayland-display$/{n;p;q;}')
        authority=$(printf '%s\n' "$args" | sed -n '/^--xwayland-xauthority$/{n;p;q;}')
        [[ -n "$display" && -n "$authority" && -r "$authority" ]] || continue
        if DISPLAY="$display" XAUTHORITY="$authority" /usr/bin/xdpyinfo >/dev/null 2>&1; then
            export DISPLAY="$display" XAUTHORITY="$authority"
            /usr/local/lib/ludus/ludus-mountctl mount
            trap '/usr/local/lib/ludus/ludus-mountctl unmount || true' EXIT
            # Register shared libraries while Steam is stopped.  The helper is
            # deliberately unprivileged: it only writes this user's Steam VDF.
            /usr/local/lib/ludus/ludus-steam-register-libraries || true
            # Shared library directories inherit the ludus group through
            # setgid, but Steam's usual umask would remove group-write access
            # from new downloads and game files.  Preserve it for the next
            # player by passing Steam a cooperative group-writable umask.
            umask 0002
            /usr/bin/bazzite-steam steam://open/bigpicture &
            steam_pid=$!
            # The splash does not have Xwayland's per-session credentials, so
            # it cannot run wmctrl itself. Signal it only after the actual
            # Big Picture/Gamepad UI window—not an early generic web helper—
            # has appeared.
            for _ in $(seq 1 450); do
                if /usr/bin/wmctrl -lx 2>/dev/null | grep -qiE 'steam.*(big picture|gamepadui)'; then
                    : > "$ready_file"
                    break
                fi
                sleep 0.2
            done
            wait "$steam_pid"
            exit $?
        fi
    done < <(pgrep -u "$(id -u)" -x kwin_wayland || true)
    sleep 0.2
done

exit 1
